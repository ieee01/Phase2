<?xml version="1.0"?>
<robot name="cstam_waiter_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Configurable Scaling for BellaBot 3D Mesh -->
  <!-- 0.00762 scales CAD model (169.2cm) to real-life BellaBot 1.29m height and 0.65m width -->
  <xacro:property name="mesh_scale" value="0.00762 0.00762 0.00762"/>

  <!-- Materials for RViz & Simulation -->
  <material name="bellabot_white">
    <color rgba="0.94 0.95 0.97 1.0"/>
  </material>
  <material name="metallic_dark">
    <color rgba="0.15 0.17 0.20 1.0"/>
  </material>
  <material name="accent_cyan">
    <color rgba="0.0 0.75 0.85 1.0"/>
  </material>
  <material name="tray_mat">
    <color rgba="0.22 0.25 0.28 1.0"/>
  </material>
  <material name="screen_glass">
    <color rgba="0.05 0.08 0.12 1.0"/>
  </material>

  <!-- Base Footprint (Ground Projection) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- Base Chassis Link with BellaBot 3D Mesh -->
  <link name="base_link">
    <!-- BellaBot Assembled 3D Visual Mesh -->
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 1.5707963"/>
      <geometry>
        <mesh filename="package://cstam_gazebo/models/robot/mesh/bellabot_v2_assembled.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="bellabot_white"/>
    </visual>

    <!-- Stable Physics Collision Cylinder -->
    <collision>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.90"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="0.55" ixy="0.0" ixz="0.0" iyy="0.55" iyz="0.0" izz="0.65"/>
    </inertial>
  </link>

  <!-- Left Drive Wheel -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.22 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Drive Wheel -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.045"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.22 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Passive Caster -->
  <link name="caster_front">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.18 0 -0.045" rpy="0 0 0"/>
  </joint>

  <!-- Rear Passive Caster -->
  <link name="caster_rear">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="metallic_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.18 0 -0.045" rpy="0 0 0"/>
  </joint>

  <!-- 360-degree LiDAR Sensor Frame (Mounted on front bumper) -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.32 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- BellaBot Serving Tray Frames (for TF / Task Monitoring) -->
  <link name="shelf_lower"/>
  <joint name="shelf_lower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_lower"/>
    <origin xyz="0.02 0 0.32" rpy="0 0 0"/>
  </joint>

  <link name="shelf_middle"/>
  <joint name="shelf_middle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_middle"/>
    <origin xyz="0.02 0 0.60" rpy="0 0 0"/>
  </joint>

  <link name="shelf_upper"/>
  <joint name="shelf_upper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_upper"/>
    <origin xyz="0.02 0 0.88" rpy="0 0 0"/>
  </joint>

  <!-- BellaBot Head Console Frame -->
  <link name="head_console"/>
  <joint name="head_console_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head_console"/>
    <origin xyz="0.05 0 1.15" rpy="0 0.35 0"/>
  </joint>

  <!-- Gazebo Sim Differential Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <max_linear_acceleration>1.2</max_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Gazebo Sim LiDAR Sensor Plugin -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <ray>
        <scan>
          <horizontal>
            <!-- +/-115 deg (1 deg steps): beyond ~119 deg the front-mounted LiDAR hits the robot's own
                 body, which the collision monitor and costmaps would treat as an obstacle inside the footprint -->
            <samples>231</samples>
            <resolution>1.0</resolution>
            <min_angle>-2.00713</min_angle>
            <max_angle>2.00713</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>15.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <gz_frame_id>laser_frame</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Material appearances in Gazebo Sim -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.94 0.95 0.97 1.0</ambient>
        <diffuse>0.94 0.95 0.97 1.0</diffuse>
        <specular>0.4 0.4 0.4 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Wheel and Caster Friction for Gazebo Sim -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="caster_front">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="caster_rear">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

</robot>
