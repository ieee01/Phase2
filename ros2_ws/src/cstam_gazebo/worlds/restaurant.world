    <!-- ===== Docking / charging station (south-east corner, against south wall) =====
         Model frame: origin = pad centre on the floor, +X points out of the dock into the room.
         Docked robot pose (world): 7.064 -12.791  yaw -1.5708 (robot facing the tower)
         Staging pose  (world): 7.064 -11.791  yaw -1.5708 (1 m in front of the dock) -->
    <model name="docking_station">
      <static>true</static>
      <pose>7.0640 -12.7909 0 0 0 1.5708</pose>
      <link name="link">
        <!-- Floor pad: visual only, so the robot can drive onto it -->
        <visual name="pad_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.01</size></box></geometry>
          <material><ambient>0.15 0.65 0.35 1</ambient><diffuse>0.15 0.65 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="pad_guide_line">
          <pose>0.1 0 0.011 0 0 0</pose>
          <geometry><box><size>0.6 0.05 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <!-- Charging tower against the wall (solid) -->
        <collision name="tower_collision">
          <pose>-0.475 0 0.225 0 0 0</pose>
          <geometry><box><size>0.15 0.5 0.45</size></box></geometry>
        </collision>
        <visual name="tower_visual">
          <pose>-0.475 0 0.225 0 0 0</pose>
          <geometry><box><size>0.15 0.5 0.45</size></box></geometry>
          <material><ambient>0.2 0.25 0.3 1</ambient><diffuse>0.2 0.25 0.3 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <!-- Charging contacts -->
        <visual name="contact_left">
          <pose>-0.395 0.1 0.12 0 0 0</pose>
          <geometry><box><size>0.01 0.06 0.03</size></box></geometry>
          <material><ambient>0.85 0.65 0.2 1</ambient><diffuse>0.85 0.65 0.2 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <visual name="contact_right">
          <pose>-0.395 -0.1 0.12 0 0 0</pose>
          <geometry><box><size>0.01 0.06 0.03</size></box></geometry>
          <material><ambient>0.85 0.65 0.2 1</ambient><diffuse>0.85 0.65 0.2 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <!-- Status LED -->
        <visual name="status_led">
          <pose>-0.395 0 0.4 0 0 0</pose>
          <geometry><box><size>0.01 0.08 0.02</size></box></geometry>
          <material><ambient>0.1 1 0.2 1</ambient><diffuse>0.1 1 0.2 1</diffuse><emissive>0.1 1 0.2 1</emissive></material>
        </visual>
        <!-- High-contrast target panel (placeholder for an AprilTag/ArUco texture) -->
        <visual name="marker_panel">
          <pose>-0.397 0 0.28 0 0 0</pose>
          <geometry><box><size>0.005 0.16 0.16</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="marker_centre">
          <pose>-0.4 0 0.28 0 0 0</pose>
          <geometry><box><size>0.005 0.08 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Dynamic Pedestrian Obstacle for Dynamic Avoidance Testing -->
    <include>
      <name>dynamic_obstacle</name>
      <uri>model://dynamic_obstacle</uri>
      <pose>-1.5 -1.3 0 0 0 1.57</pose>
    </include>
  </world>
